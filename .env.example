# Local PostgreSQL warehouse (current default). Keep this working.
DATA_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amex_credit_risk
DB_USER=your_username
DB_PASSWORD=your_password

# AWS S3 configuration
# Do not put real keys in git. Never upload train_data.csv until we agree.
AWS_REGION=us-west-2
S3_BUCKET=aayusha-amex-credit-risk
S3_PREFIX=amex

# Snowflake — fill after you create the trial account.
# Account looks like xy12345.us-west-2 or orgname-accountname.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=AMEX_WH
SNOWFLAKE_DATABASE=AMEX_CREDIT_RISK
SNOWFLAKE_SCHEMA=ANALYTICS
